# Optional SNS email subscriptions for Task 6.
# `npm run deploy` loads these values from `.env` and passes them to CDK.

PRODUCT_CREATED_EMAIL=your-email@example.com
EXPENSIVE_PRODUCT_CREATED_EMAIL=your-expensive-filter-email@example.com

# Basic authorizer credentials for Task 7.
# The deployed Lambda receives an environment variable named after your GitHub login.
AUTH_LOGIN=tosigaeva
AUTH_PASSWORD=TEST_PASSWORD

# Alternative direct format required by the task also works with dotenv:
# tosigaeva=TEST_PASSWORD
